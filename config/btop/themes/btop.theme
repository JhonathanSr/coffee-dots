# Theme: Transparent Prism - Lavender
# Generated from Zed/Aero UI Palette

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color (neutral_10)
theme[main_fg]="#f7f2ff"

# Title color for boxes (accent_indigo / accent_purple)
theme[title]="#948ae3"

# Highlight color for keyboard shortcuts (accent_blue)
theme[hi_fg]="#59d4e6"

# Background color of selected item in processes box (neutral_3)
theme[selected_bg]="#383540"

# Foreground color of selected item in processes box (neutral_10)
theme[selected_fg]="#f7f2ff"

# Color of inactive/disabled text (neutral_6)
theme[inactive_fg]="#5c5963"

# Misc colors for processes box including mini cpu graphs (accent_warm_grey)
theme[proc_misc]="#8a878f"

# Box outline and divider line color
theme[cpu_box]="#948ae3"
theme[mem_box]="#948ae3"
theme[net_box]="#948ae3"
theme[proc_box]="#948ae3"
theme[div_line]="#2e2b33"

# Temperature graph gradient (accent_blue -> accent_indigo -> accent_pink)
theme[temp_start]="#59d4e6"
theme[temp_mid]="#948ae3"
theme[temp_end]="#fc618c"

# CPU graph gradient (accent_blue -> accent_purple -> bright_red)
theme[cpu_start]="#59d4e6"
theme[cpu_mid]="#948ae3"
theme[cpu_end]="#fc618c"

# Memory & Network gradients (ext_blue -> ext_purple -> ext_pink)
theme[free_start]="#59d4e6"
theme[free_mid]="#948ae3"
theme[free_end]="#fc618c"

theme[cached_start]="#59d4e6"
theme[cached_mid]="#948ae3"
theme[cached_end]="#fc618c"

theme[available_start]="#59d4e6"
theme[available_mid]="#948ae3"
theme[available_end]="#fc618c"

theme[used_start]="#59d4e6"
theme[used_mid]="#948ae3"
theme[used_end]="#fc618c"

theme[download_start]="#59d4e6"
theme[download_mid]="#948ae3"
theme[download_end]="#fc618c"

theme[upload_start]="#59d4e6"
theme[upload_mid]="#948ae3"
theme[upload_end]="#fc618c"