#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Name:        setpowerprofiles.sh
# Description: Set the power profile via powerprofilesctl with AC autodetection.
# Style:       coffee-dots ☕
# -----------------------------------------------------------------------------

# --- COFFEE BLEND (Config) ---------------------------------------------------
ACTION="${1:-autodetect}"
SETTLE_DELAY=0.3

# --- ROASTING LOGIC ---------------------------------------------------------

# Auto-detect when called with no argument or explicit "autodetect"
if [[ "$ACTION" == "autodetect" ]]; then
    # Settle delay for kernel sysfs updates on udev events
    sleep "$SETTLE_DELAY"

    ACTION="battery"
    for ps in /sys/class/power_supply/*; do
        [[ -r "$ps/online" && -r "$ps/type" ]] || continue
        
        TYPE=$(cat "$ps/type")
        [[ "$TYPE" == "Mains" || "$TYPE" == "USB" ]] || continue
        
        if [[ $(cat "$ps/online") == "1" ]]; then
            ACTION="ac"
            break
        fi
    done
fi

# Fetch available system profiles
mapfile -t PROFILES < <(powerprofilesctl list | awk '/^\s*[* ]\s*[a-zA-Z0-9\-]+:$/ { gsub(/^[*[:space:]]+|:$/,""); print }')

# Apply profiles based on energy source
case "$ACTION" in
    ac)
        # High caffeine mode: Prefer performance, fall back to balanced
        if [[ " ${PROFILES[*]} " == *" performance "* ]]; then
            powerprofilesctl set performance
        else
            powerprofilesctl set balanced
        fi
        ;;
    battery)
        # Low energy mode
        powerprofilesctl set balanced
        ;;
    *)
        echo "☕ [Error]: Unknown profile action '$ACTION'. Use ac, battery, or autodetect."
        exit 1
        ;;
esac