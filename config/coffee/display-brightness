#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Intelligent Display Brightness & OSD Sync
# -------------------------------------------------------------------------

step="${1:-+5%}"

# 1. Manejo de DPMS (Encender / Apagar pantallas)
if [[ "$step" == "off" ]]; then
  hyprctl dispatch dpms off >/dev/null 2>&1
  exit 0
elif [[ "$step" == "on" ]]; then
  hyprctl dispatch dpms on >/dev/null 2>&1
  exit 0
fi

# 2. Mecanismo defensivo anti-race conditions (Evita glitches en SwayOSD)
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
exec 9>"$runtime_dir/coffee-brightness.lock"
flock -n 9 || exit 0

# 3. Heurística para detectar la interfaz de backlight correcta (AMD/Intel/ACPI)
device="$(ls -1 /sys/class/backlight 2>/dev/null | head -n1)"
for candidate in amdgpu_bl* intel_backlight acpi_video*; do
  if [[ -e "/sys/class/backlight/$candidate" ]]; then
    device="$candidate"
    break
  fi
done

[[ -z "$device" ]] && exit 1

# 4. Obtener el porcentaje de brillo actual
current=$(brightnessctl -d "$device" -m | cut -d',' -f4 | tr -d '%')

# 5. Algoritmo de pasos inteligentes (Ajuste fino bajo el 5%)
if [[ "$step" == "+5%" ]]; then
  if ((current < 5)); then
    ((target = current + 1))
  else
    ((target = current + 5))
  fi
  ((target > 100)) && target=100
  step="$target%"
elif [[ "$step" == "5%-" ]]; then
  if ((current <= 5)); then
    ((target = current - 1))
  else
    ((target = current - 5))
  fi
  ((target < 1)) && target=1
  step="$target%"
fi

# 6. Aplicar el cambio de brillo físico
brightnessctl -d "$device" set "$step" >/dev/null

# 7. Despachar el OSD
# Determinamos la acción basada en el valor de $step (que ya ha sido normalizado a un número + %)
action="raise"
[[ "$1" == *"-" ]] && action="lower"

# Usamos el comando adecuado sin el exec si quieres ser más flexible,
# pero si quieres mantener el exec, pásale el parámetro correcto
if command -v swayosd-wrapper >/dev/null 2>&1; then
  exec swayosd-wrapper --brightness "$action"
else
  exec swayosd-client --brightness "$action"
fi

