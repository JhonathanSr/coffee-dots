#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Wi-Fi Toggle, Persistence, RFKill Fix & OSD Sync
# Style:       coffee-dots ☕
# -------------------------------------------------------------------------

STATE_FILE="$HOME/.local/state/coffee/wifi-disabled"
OSD_WRAPPER="$HOME/.config/coffee/swayosd-wrapper"

show_osd() {
    local icon="$1"
    local message="$2"
    if [ -x "$OSD_WRAPPER" ]; then
        exec "$OSD_WRAPPER" --custom-icon "$icon" --custom-message "$message"
    else
        exec swayosd-client --custom-icon "$icon" --custom-message "$message"
    fi
}

enable() {
    # DEFENSA: Forzar el desbloqueo a nivel de kernel antes de encender NM
    if command -v rfkill >/dev/null 2>&1; then
        rfkill unblock wlan >/dev/null 2>&1 || sudo rfkill unblock wlan >/dev/null 2>&1
    fi

    nmcli radio wifi on
    rm -f "$STATE_FILE"
    show_osd "network-wireless-signal-excellent-symbolic" "Wi-Fi Enabled"
}

disable() {
    nmcli radio wifi off
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "false" > "$STATE_FILE"
    show_osd "network-wireless-offline-symbolic" "Wi-Fi Disabled"
}

case "${1:-toggle}" in
    on)     enable ;;
    off)    disable ;;
    toggle)
        # Doble verificación: Verificamos tanto el archivo como el estado de rfkill
        if command -v rfkill >/dev/null 2>&1 && rfkill list wlan | grep -q "Soft blocked: yes"; then
            enable
        else
            STATE=$(nmcli radio wifi 2>/dev/null)
            if [[ -f "$STATE_FILE" || "$STATE" == "disabled" ]]; then
                enable
            else
                disable
            fi
        fi
        ;;
    *)
        echo "Usage: $(basename "$0") [on|off|toggle]" >&2
        exit 1
        ;;
esac