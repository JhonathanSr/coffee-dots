#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Audio Output Switcher & OSD Sync (PipeWire Native)
# -------------------------------------------------------------------------

# 1. Obtener los sinks de audio válidos usando pw-dump (JSON nativo de PipeWire)
# Filtramos nodos que sean Audio/Sink y que no estén suspendidos o no disponibles
sinks=$(pw-dump | jq '[.[] | select(.type == "PipeWire:Interface:Node" and .info.props."media.class" == "Audio/Sink")]')
sinks_count=$(echo "$sinks" | jq '. | length')

if (( sinks_count == 0 )); then
    if command -v swayosd-wrapper >/dev/null 2>&1; then
        exec swayosd-wrapper --custom-message "No audio devices found"
    else
        exec swayosd-client --custom-message "No audio devices found"
    fi
    exit 1
fi

# 2. Obtener el ID del Sink por defecto actual mediante wpctl
current_sink_id=$(wpctl inspect @DEFAULT_AUDIO_OUTPUT@ | grep "id:" | awk '{print $2}')
current_sink_index=$(echo "$sinks" | jq -r --argid id "$current_sink_id" 'map(.id) | index($id)')

# 3. Calcular el índice del siguiente dispositivo
if [[ "$current_sink_index" != "null" ]]; then
    next_sink_index=$(((current_sink_index + 1) % sinks_count))
else
    next_sink_index=0
fi

next_sink=$(echo "$sinks" | jq -r ".[$next_sink_index]")
next_sink_id=$(echo "$next_sink" | jq -r '.id')

# 4. Extraer el nombre amigable (Prioriza el nombre descriptivo de la propiedad)
next_sink_description=$(echo "$next_sink" | jq -r '.info.props."node.description" // .info.props."node.nick" // .info.props."node.name"')

# 5. Obtener volumen y estado de muteo del siguiente dispositivo usando wpctl
# wpctl get-volume retorna algo como "Volume: 0.45 [MUTED]"
vol_info=$(wpctl get-volume "$next_sink_id")
volume=$(echo "$vol_info" | awk '{print $2 * 100}')
is_muted=$(echo "$vol_info" | grep -q "MUTED" && echo "true" || echo "false")

if [[ "$is_muted" == "true" ]] || (( volume == 0 )); then
    icon_state="muted"
elif (( volume <= 33 )); then
    icon_state="low"
elif (( volume <= 66 )); then
    icon_state="medium"
else
    icon_state="high"
fi

next_sink_volume_icon="sink-volume-${icon_state}-symbolic"

# 6. Cambiar el dispositivo por defecto si es diferente al actual
if [[ "$next_sink_id" != "$current_sink_id" ]]; then
    wpctl set-default "$next_sink_id"
fi

# 7. Notificar el cambio de dispositivo a través del wrapper de SwayOSD
if command -v swayosd-wrapper >/dev/null 2>&1; then
    exec swayosd-wrapper --custom-message "$next_sink_description" --custom-icon "$next_sink_volume_icon"
else
    exec swayosd-client --custom-message "$next_sink_description" --custom-icon "$next_sink_volume_icon"
fi