#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Touchpad Toggle, Persistence & OSD Sync
# -------------------------------------------------------------------------

STATE_FILE="$HOME/.local/state/coffee/touchpad-disabled"

# 1. Detectar el nombre exacto del touchpad usando hyprctl y jq
device=$(hyprctl devices -j | jq -r '.mice[] | select(.name | ascii_downcase | contains("touchpad")) | .name' | head -n1)

if [[ -z "$device" ]]; then
    echo "No touchpad device found" >&2
    exit 1
fi

# Función para habilitar el touchpad
enable() {
    hyprctl keyword "device:$device:enabled" true >/dev/null
    rm -f "$STATE_FILE"
    
    if command -v swayosd-wrapper >/dev/null 2>&1; then
        exec swayosd-wrapper --custom-icon input-touchpad-symbolic --custom-message "Touchpad enabled"
    else
        exec swayosd-client --custom-icon input-touchpad-symbolic --custom-message "Touchpad enabled"
    fi
}

# Función para deshabilitar el touchpad
disable() {
    hyprctl keyword "device:$device:enabled" false >/dev/null
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "false" > "$STATE_FILE"
    
    if command -v swayosd-wrapper >/dev/null 2>&1; then
        exec swayosd-wrapper --custom-icon touchpad-disabled-symbolic --custom-message "Touchpad disabled"
    else
        exec swayosd-client --custom-icon touchpad-disabled-symbolic --custom-message "Touchpad disabled"
    fi
}

# 2. Controlar el flujo según el argumento pasado
case "${1:-toggle}" in
    on)     enable ;;
    off)    disable ;;
    toggle) if [[ -f "$STATE_FILE" ]]; then enable; else disable; fi ;;
    *)      echo "Usage: $(basename "$0") [on|off|toggle]" >&2; exit 1 ;;
esac