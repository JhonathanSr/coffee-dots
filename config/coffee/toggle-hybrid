#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - LOQ GPU Profile Switcher (Native Mode)
# -------------------------------------------------------------------------

# Asegurar que supergfxctl esté activo
if ! command -v supergfxctl >/dev/null 2>&1; then
    echo "Error: supergfxctl no está instalado en el sistema." >&2
    exit 1
fi

# Validar que exista 'gum' para la interfaz interactiva
if ! command -v gum >/dev/null 2>&1; then
    echo "Error: Se requiere 'gum' para ejecutar este script interactivo." >&2
    exit 1
fi

CONFIG_FILE="/etc/supergfxd.conf"
CURRENT_MODE=$(supergfxctl -g)

case "$CURRENT_MODE" in
"Integrated")
    if gum confirm "La RTX 5050 está APAGADA. ¿Deseas activar el modo Híbrido?"; then
        # Modificar el perfil de forma segura manteniendo tus flags de Hotplug nativo
        sudo sed -i 's/"mode": ".*"/"mode": "Hybrid"/' "$CONFIG_FILE"
        
        # En tu LOQ, cambiar a Hybrid se puede aplicar cerrando sesión gráfica,
        # pero si prefieres la estabilidad del reinicio limpio bajo Limine:
        notify-send "GPU Switch" "Reiniciando el sistema en modo Híbrido..." -i gputop
        sudo systemctl reboot
    fi
    ;;

"Hybrid")
    if gum confirm "La RTX 5050 está ACTIVA. ¿Deseas pasar a modo Integrado (Batería)?"; then
        # Cambiar el modo a Integrado
        sudo sed -i 's/"mode": ".*"/"mode": "Integrated"/' "$CONFIG_FILE"
        
        notify-send "GPU Switch" "Reiniciando el sistema en modo iGPU..." -i battery
        sudo systemctl reboot
    fi
    ;;

*)
    echo "Estado de GPU no compatible o desconocido: $CURRENT_MODE" >&2
    exit 1
    ;;
esac
