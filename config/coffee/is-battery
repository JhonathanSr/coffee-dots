#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Name:        is-battery.sh
# Description: Returns true (exit 0) if an active battery is present on the system.
# Style:       coffee-dots ☕
# -----------------------------------------------------------------------------

# --- ROASTING LOGIC ---------------------------------------------------------

for bat in /sys/class/power_supply/BAT*; do
    [[ -r "$bat/present" ]] &&
    [[ $(cat "$bat/present") == "1" ]] &&
    [[ $(cat "$bat/type") == "Battery" ]] &&
    exit 0
done

# No active coffee cell found
exit 1