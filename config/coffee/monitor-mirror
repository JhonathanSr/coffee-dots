#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Laptop Display Mirroring Toggle
# -------------------------------------------------------------------------

STATE_FILE="$HOME/.local/state/coffee/monitor-mirrored"

# 1. Obtener nombres de los monitores dinámicamente con jq
# El interno suele contener "eDP" (Embedded DisplayPort en laptops)
INTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | ascii_downcase | contains("edp")).name' | head -n 1)
# El externo es el primero que NO sea el interno
EXTERNAL=$(hyprctl monitors -j | jq -r --arg int "$INTERNAL" '.[] | select(.name != $int).name' | head -n 1)

# Validar hardware antes de actuar
if [[ -z "$INTERNAL" ]]; then
    echo "No se detectó la pantalla interna de la laptop." >&2
    exit 1
fi

on() {
    if [[ -z "$EXTERNAL" ]]; then
        if command -v swayosd-wrapper >/dev/null 2>&1; then
            exec swayosd-wrapper --custom-icon "video-display-symbolic" --custom-message "No external monitor found"
        fi
        exit 1
    fi

    # Aplicar el modo espejo nativo en Hyprland
    hyprctl keyword monitor "$EXTERNAL, preferred, auto, 1, mirror, $INTERNAL" >/dev/null
    touch "$STATE_FILE"

    if command -v swayosd-wrapper >/dev/null 2>&1; then
        exec swayosd-wrapper --custom-icon "video-display-symbolic" --custom-message "Mirror Mode: Enabled"
    fi
}

off() {
    # Al quitar el mirror, restablecemos el monitor externo a modo extendido automático
    if [[ -n "$EXTERNAL" ]]; then
        hyprctl keyword monitor "$EXTERNAL, preferred, auto, 1" >/dev/null
    fi
    rm -f "$STATE_FILE"

    if command -v swayosd-wrapper >/dev/null 2>&1; then
        exec swayosd-wrapper --custom-icon "video-display-symbolic" --custom-message "Extended Mode Restored"
    fi
}

# 2. Controlar el flujo según el estado o argumento
case "${1:-toggle}" in
    on)  on ;;
    off) off ;;
    toggle)
        if [[ -f "$STATE_FILE" ]]; then
            off
        else
            on
        fi
        ;;
    *)
        echo "Usage: $(basename "$0") {on|off|toggle}" >&2
        exit 1
        ;;
esac