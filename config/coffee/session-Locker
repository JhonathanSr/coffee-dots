#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Session Locker & Power Management
# -------------------------------------------------------------------------

# Evitar instancias duplicadas de hyprlock
if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    # Despertar y restaurar estados al desbloquear
    coffee-system-wake
  ) &
fi

# Restablecer la distribución del teclado al layout principal de forma segura
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Asegurar el bloqueo del llavero de contraseñas
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Matar cualquier proceso del screensaver previo
pkill -f org.coffee.screensaver

# Gestión de energía defensiva tras el bloqueo
if [[ ${COFFEE_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    # Validar que la pantalla siga bloqueada antes de apagar los periféricos
    pidof hyprlock >/dev/null || exit 0
    coffee-brightness-keyboard off
    coffee-brightness-display off
  ) &
fi