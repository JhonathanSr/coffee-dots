#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Bluetooth Toggle, Persistence, RFKill Fix & OSD Sync
# Style:       coffee-dots ☕
# -------------------------------------------------------------------------

STATE_FILE="$HOME/.local/state/coffee/bluetooth-disabled"
OSD_WRAPPER="$HOME/.config/coffee/swayosd-wrapper"

# Función para enviar la señal visual al monitor enfocado
show_osd() {
    local icon="$1"
    local message="$2"
    
    if [ -x "$OSD_WRAPPER" ]; then
        exec "$OSD_WRAPPER" --custom-icon "$icon" --custom-message "$message"
    else
        exec swayosd-client --custom-icon "$icon" --custom-message "$message"
    fi
}

# Función para habilitar el Bluetooth
enable() {
    # DEFENSA: Forzar el desbloqueo a nivel de kernel antes de encender con bluetoothctl
    if command -v rfkill >/dev/null 2>&1; then
        rfkill unblock bluetooth >/dev/null 2>&1 || sudo rfkill unblock bluetooth >/dev/null 2>&1
    fi

    bluetoothctl power on >/dev/null 2>&1
    rm -f "$STATE_FILE"
    show_osd "network-bluetooth-activated-symbolic" "Bluetooth Enabled"
}

# Función para deshabilitar el Bluetooth
disable() {
    bluetoothctl power off >/dev/null 2>&1
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "false" > "$STATE_FILE"
    show_osd "network-bluetooth-inactive-symbolic" "Bluetooth Disabled"
}

# Controlar el flujo según el argumento pasado (Fallback a toggle si viene vacío)
case "${1:-toggle}" in
    on)     enable ;;
    off)    disable ;;
    toggle)
        # Doble verificación: Verificamos tanto el archivo de estado como rfkill
        if command -v rfkill >/dev/null 2>&1 && rfkill list bluetooth | grep -q "Soft blocked: yes"; then
            enable
        else
            STATE=$(bluetoothctl show 2>/dev/null | awk '/PowerState/ {print $2}')
            if [[ -f "$STATE_FILE" || "$STATE" != "on" ]]; then
                enable
            else
                disable
            fi
        fi
        ;;
    *)
        echo "Usage: $(basename "$0") [on|off|toggle]" >&2
        exit 1
        ;;
esac