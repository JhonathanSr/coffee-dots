#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Mic Toggle, LED & OSD Sync
# -------------------------------------------------------------------------

# 1. Toggle del micrófono con PipeWire
wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

# 2. Evaluar el estado real de WirePlumber
if wpctl get-mute @DEFAULT_AUDIO_SOURCE@ | rg -q '\[MUTED\]'; then
  led=on
  osd_message='Microphone muted'
  osd_icon='microphone-sensitivity-muted-symbolic'
else
  led=off
  osd_message='Microphone on'
  osd_icon='audio-input-microphone-symbolic'
fi

# 3. Control de hardware: LED físico
if [[ -e /sys/class/leds/platform::micmute/brightness ]]; then
  case "$led" in
    on)  value=1 ;;
    off) value=0 ;;
    *)   exit 1 ;;
  esac
  brightnessctl --device="platform::micmute" set "$value" >/dev/null 2>&1 || true
fi

# 4. Despachar el OSD a través de tu wrapper usando el PATH
if command -v swayosd-wrapper >/dev/null 2>&1; then
  exec swayosd-wrapper --custom-message "$osd_message" --custom-icon "$osd_icon"
else
  exec swayosd-client --custom-message "$osd_message" --custom-icon "$osd_icon"
fi