#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - Keyboard Backlight Control & OSD Sync
# -------------------------------------------------------------------------

direction="${1:-up}"

# 1. Encontrar el dispositivo de retroiluminación del teclado de forma segura
device=""
for candidate in /sys/class/leds/*kbd_backlight*; do
    if [[ -e "$candidate" ]]; then
        device="$(basename "$candidate")"
        break
    fi
done

if [[ -z "$device" ]]; then
    echo "No keyboard backlight device found" >&2
    exit 1
fi

# 2. Manejo rápido de estados estáticos
if [[ "$direction" == "off" ]]; then
    brightnessctl -sd "$device" set 0 >/dev/null
    exit 0
elif [[ "$direction" == "restore" ]]; then
    brightnessctl -rd "$device" >/dev/null
    exit 0
fi

# 3. Obtener métricas actuales del hardware
max_brightness="$(brightnessctl -d "$device" max)"
current_brightness="$(brightnessctl -d "$device" get)"

# Calcular pasos proporcionales (mínimo 1)
step=$(( max_brightness / 10 ))
(( step < 1 )) && step=1

# 4. Determinar el nuevo nivel según el argumento
if [[ "$direction" == "cycle" ]]; then
    new_brightness=$(( current_brightness + step ))
    (( new_brightness > max_brightness )) && new_brightness=0
elif [[ "$direction" == "up" ]]; then
    new_brightness=$(( current_brightness + step ))
    (( new_brightness > max_brightness )) && new_brightness=$max_brightness
else
    new_brightness=$(( current_brightness - step ))
    (( new_brightness < 0 )) && new_brightness=0
fi

# 5. Aplicar brillo al hardware
brightnessctl -d "$device" set "$new_brightness" >/dev/null

# 6. Despachar el OSD a SwayOSD delegando en tu wrapper
if command -v swayosd-wrapper >/dev/null 2>&1; then
    # El flag --kbd-brightness de swayosd-client maneja nativamente la animación del teclado
    if [[ "$direction" == "down" ]]; then
        exec swayosd-wrapper --kbd-brightness lower
    else
        exec swayosd-wrapper --kbd-brightness raise
    fi
else
    # Fallback directo al cliente si el wrapper no responde
    if [[ "$direction" == "down" ]]; then
        exec swayosd-client --kbd-brightness lower
    else
        exec swayosd-client --kbd-brightness raise
    fi
fi