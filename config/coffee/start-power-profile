#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Name:        start-power-profile
# Description: Set the correct power profile on boot based on AC/Battery state.
# Style:       coffee-dots ☕
# -----------------------------------------------------------------------------

# --- COFFEE BLEND (Config) ---------------------------------------------------
# Commands to check power source and set profiles
CHECK_BATTERY="is-battery"
CHECK_AC="is-ac"
SET_PROFILE="set-power-profile"

PROFILE_BATTERY="battery"
PROFILE_AC="ac"

# --- ROASTING LOGIC ---------------------------------------------------------

if $CHECK_BATTERY && ! $CHECK_AC; then
    # Low energy mode
    $SET_PROFILE "$PROFILE_BATTERY"
else
    # Full caffeine mode
    $SET_PROFILE "$PROFILE_AC"
fi