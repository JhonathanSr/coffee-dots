#!/bin/bash

# ==============================================================================
# SCRIPT: Wayland Screen Recorder (wl-screenrec wrapper)
# DESCRIPCIÓN: Utilidad de grabación de pantalla para Wayland con soporte para
#              regiones (slurp) o pantalla completa. Funciona como un toggle
#              (encendido/apagado) y envía notificaciones de estado.
# DEPENDENCIAS: wl-screenrec, slurp, libnotify, xdg-user-dirs.
# AUTOR: Jhonathan Ruiz (Coffee-Dots)
# FECHA: 15/05/2026
# ==============================================================================

# --- Configuración de Directorio de Salida ---
# Buscamos las carpetas de usuario estándar (XDG). Si no se encuentra una 
# configuración específica, se utiliza la carpeta Videos por defecto.
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos/screenrecording}}"

# Verificación de integridad del sistema de archivos.
if [[ ! -d "$OUTPUT_DIR" ]]; then
  notify-send "Screen recording directory does not exist: $OUTPUT_DIR" -u critical -t 3000
  exit 1
fi

# --- Función de Grabación (Engine) ---
# Ejecuta wl-screenrec con parámetros optimizados para compatibilidad y calidad.
# Encoder: libx264 (H.264) con CRF 23 para un balance óptimo peso/calidad.
screenrecording() {
  filename="$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
  notify-send "Screen recording starting..." -t 1000
  sleep 1

  wl-screenrec -f "$filename" --ffmpeg-encoder-options="-c:v libx264 -crf 23 -preset medium -movflags +faststart" "$@"
}

# --- Lógica de Control (Toggle & Modes) ---
# 1. Si ya existe un proceso activo, lo finalizamos (Stop Recording).
if pgrep -x wl-screenrec >/dev/null; then
  pkill -x wl-screenrec
  notify-send "Video generado en $OUTPUT_DIR" -t 2000

# 2. Modo Pantalla Completa: Se activa pasando el argumento 'output'.
elif [[ "$1" == "output" ]]; then
  screenrecording

# 3. Modo Región (Default): Lanza slurp para seleccionar un área específica.
else
  region=$(slurp) || exit 1
  screenrecording -g "$region"
fi