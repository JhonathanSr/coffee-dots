#!/bin/bash

# ==============================================================================
# SCRIPT: Battery Health Monitor
# DESCRIPCIÓN: Servicio ligero que monitorea el estado de la batería mediante 
#              upower. Gestiona alertas visuales en niveles críticos y bajos,
#              utilizando un sistema de "flags" en memoria volátil (/run) para
#              evitar el spam de notificaciones.
# DEPENDENCIAS: upower, libnotify, sed, grep.
# AUTOR: Jhonathan Ruiz (Coffee-Dots)
# FECHA: 15/05/2026
# ==============================================================================

# --- Configuración de Umbrales (Thresholds) ---
# Definimos el límite de carga baja (10%) y el nivel crítico de peligro (5%).
LOW_THRESHOLD=10
CRIT_THRESHOLD=5

# --- Gestión de Estado (Flags) ---
# Archivos temporales para recordar que ya se envió una notificación.
# Ubicados en /run/user para asegurar que se limpien al reiniciar.
FLAG_LOW="/run/user/$UID/bat_low_notified"
FLAG_CRIT="/run/user/$UID/bat_crit_notified"

# --- Funciones de Extracción de Datos ---

# Obtiene el porcentaje numérico de la batería (limpia el símbolo %).
get_battery_percentage() {
  upower -i $(upower -e | grep 'BAT') | grep -E "percentage" | grep -o '[0-9]\+%' | sed 's/%//'
}

# Detecta el estado actual: discharging, charging o full.
get_battery_state() {
  upower -i $(upower -e | grep 'BAT') | grep -E "state" | awk '{print $2}'
}

# --- Lógica de Notificaciones ---
# Envía alertas al escritorio con prioridad crítica y persistencia de 30s.
send_notification() {
  # $1: Urgencia (normal/critical), $2: Título, $3: Mensaje
  notify-send -u "$1" "$2" "$3" -i battery-caution -t 30000
}

# --- Ejecución Principal ---
BATTERY_LEVEL=$(get_battery_percentage)
BATTERY_STATE=$(get_battery_state)

# Solo actuamos si el equipo no está conectado a la corriente.
if [[ "$BATTERY_STATE" == "discharging" ]]; then

  # 1. NIVEL ULTRA CRÍTICO (5%) - Prioridad máxima para evitar pérdida de datos.
  if [[ "$BATTERY_LEVEL" -le "$CRIT_THRESHOLD" ]]; then
    if [[ ! -f "$FLAG_CRIT" ]]; then
      send_notification "critical" "󱐋 ¡PELIGRO DE APAGADO!" "Batería al ${BATTERY_LEVEL}%. Conecta el cargador YA."
      touch "$FLAG_CRIT"
    fi

  # 2. NIVEL BAJO (10%) - Advertencia estándar de movilidad.
  elif [[ "$BATTERY_LEVEL" -le "$LOW_THRESHOLD" ]]; then
    if [[ ! -f "$FLAG_LOW" ]]; then
      send_notification "normal" "󱐋 Batería Baja" "Nivel actual: ${BATTERY_LEVEL}%."
      touch "$FLAG_LOW"
    fi
  fi

else
  # Si el estado es 'charging' o 'full', reseteamos las banderas para el próximo ciclo.
  rm -f "$FLAG_LOW" "$FLAG_CRIT"
fi