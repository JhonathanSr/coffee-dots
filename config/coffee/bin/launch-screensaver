#!/bin/bash

# ==============================================================================
# SCRIPT: Multi-Monitor Screensaver Spawner
# DESCRIPCIÓN: Orquesta el despliegue de un protector de pantalla basado en terminal
#              (Ghostty) a lo largo de todas las salidas de video activas en 
#              Hyprland, preservando el foco del monitor original del usuario.
# DEPENDENCIAS: hyprland (hyprctl), jq, ghostty, coreutils (pgrep).
# AUTOR: Jhonathan Ruiz (Coffee-Dots)
# FECHA: 15/05/2026
# ==============================================================================


# --- Verificación de Dependencias Críticas ---s
# Si el motor de efectos de terminal 'tte' (Terminal Text Effects) no está 
# instalado en el sistema, el script aborta de forma silenciosa.
if ! command -v tte &>/dev/null; then
  exit 1
fi

# --- Cláusula de Salvaguarda (Instancia Única) ---
# Evita la sobreposición de procesos si el protector de pantalla ya está en ejecución.
pgrep -f org.omarchy.screensaver && exit 0

# --- Control de Estado y Forzado ---
# Evalúa si el protector de pantalla ha sido desactivado globalmente por el usuario.
# Permite saltarse esta restricción si se invoca el script con el argumento "force".
if omarchy-toggle-enabled screensaver-off && [[ "$1" != "force" ]]; then
  exit 1
fi

# --- Limpieza de Interfaz Visual ---
# Envía una señal de salida silenciosa al lanzador Walker para cerrar cualquier 
# overlay o menú flotante abierto antes de renderizar el protector de pantalla.
walker -q

# --- Captura de Entorno Actual ---
focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

# --- Funciones de Abstracción de Hyprland (IPC/Dispatchers) ---

# Gestiona el cambio de foco entre monitores de forma segura, intentando usar 
# llamadas nativas del ecosistema Omarchy o cayendo en el comando estándar de hyprctl.
hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

# Ejecuta comandos en segundo plano mapeándolos al backend de despacho o mediante Bash.
hypr_exec() {
  local command="$1"
  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

# --- Despliegue Adaptativo por Monitor ---
# Itera sobre cada monitor físico conectado y detectado en el backend de Hyprland.
for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"

  # Determina el emulador de terminal por defecto del sistema para aplicar sus 
  # banderas específicas de clase, fuentes y configuraciones de aislamiento visual.
  case "$terminal" in
  *Alacritty*)
    hypr_exec "alacritty --class=org.omarchy.screensaver --config-file ~/.local/share/omarchy/default/alacritty/screensaver.toml -e omarchy-screensaver"
    ;;
  *ghostty*)
    # Configuración optimizada para Ghostty: define la clase para windowrules y ajusta la fuente a 18pt.
    hypr_exec "ghostty --class=org.omarchy.screensaver --config-file=~/.local/share/omarchy/default/ghostty/screensaver --font-size=18 -e omarchy-screensaver"
    ;;
  *foot*)
    hypr_exec "foot --app-id=org.omarchy.screensaver --config=\"$OMARCHY_PATH/default/foot/screensaver.ini\" -e omarchy-screensaver"
    ;;
  *kitty*)
    hypr_exec "kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e omarchy-screensaver"
    ;;
  *)
    # Notificación de advertencia en caso de usar una terminal no mapeada en las reglas de pantalla completa.
    notify-send -u low "✋  Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
    ;;
  esac
done

# --- Restauración de Estado ---
# Devuelve el control, el puntero y el foco al monitor donde te encontrabas trabajando originalmente.
hypr_focus_monitor "$focused"