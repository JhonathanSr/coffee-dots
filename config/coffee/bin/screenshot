#!/bin/bash

# ==============================================================================
# SCRIPT: Wayland Advanced Screenshot Tool (Hyprshot + Satty)
# DESCRIPCIÓN: Utilidad para captura de pantalla bajo Hyprland. Permite capturar
#              una región (por defecto) o la pantalla completa, enviando el stream
#              directo a Satty para su edición, copiado al portapapeles (wl-copy)
#              y guardado automático.
# DEPENDENCIAS: hyprshot, satty, slurp, wl-clipboard, xdg-user-dirs.
# AUTOR: Jhonathan Ruiz (Coffee-Dots)
# FECHA: 15/05/2026
# ==============================================================================

# --- Configuración de Directorio de Salida ---
# Importamos las rutas de usuario estándar (XDG). Prioriza la variable personalizada
# del ecosistema y cae en la carpeta de Imágenes por defecto.
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

# Verificación de la existencia del directorio de destino.
if [[ ! -d "$OUTPUT_DIR" ]]; then
  notify-send "Screenshot directory does not exist: $OUTPUT_DIR" -u critical -t 3000
  exit 1
fi

# --- Flujo de Captura y Edición Dinámica ---
# 1. pkill slurp: Si ya hay una instancia de selección activa, la mata para actuar como toggle.
# 2. hyprshot: Realiza la captura de la región (o argumento pasado como $1) de forma cruda.
# 3. satty: Recibe la imagen por STDIN (-), procesa la edición interactiva y gestiona
#    las acciones de copiado al portapapeles y guardado automático al presionar Enter.
pkill slurp || hyprshot -m ${1:-region} --raw | \
  satty --filename - \
    --output-filename "$OUTPUT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png" \
    --early-exit \
    --actions-on-enter save-to-clipboard \
    --save-after-copy \
    --copy-command 'wl-copy'