configuration {
    show-icons:                 true;
    display-drun:               "";
    drun-display-format:        "{name}";
}

* {
    font: "JetBrainsMono Nerd Font 10";
    bg: #2e3440; /* Fondo oscuro */
    fg: #d8dee9; /* Texto claro */
    accent: #4c566a;
    border-col: #d8dee9;
}

window {
    width: 350px; /* Tamaño pequeño como Walker */
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    padding: 15px;
    children: [inputbar, listview];
}

inputbar {
    children: [prompt, entry];
    background-color: transparent;
    padding: 0 0 10px 0;
}

prompt {
    background-color: transparent;
    text-color: @accent;
    padding: 0 10px 0 0;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Buscar...";
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 5px;
    fixed-height: false;
}

element {
    padding: 8px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
    background-color: transparent;
}