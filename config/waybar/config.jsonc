{
  "include": [
    "~/.config/waybar/modules/*.jsonc",
    "~/.config/waybar/modules/custom/*.jsonc",
    "~/.config/waybar/modules/hyprland/*.jsonc"

    // Modules that are not included by default:
    // "~/.config/waybar/modules/extras/*.jsonc"
  ],

  /*------------
	    Layout
	------------*/

  "modules-left": ["custom/distro", "hyprland/workspaces", "custom/media"],
  "modules-center": [
    //"temperature",
    //"memory",
    "cpu",
    "clock#date",
    "clock#time",
    "group/hiddencenter"
  ],
  "modules-right": [
    // "backlight",
    "group/hiddenrigth",
    "network",
    "pulseaudio#output",
    "battery",
    "custom/power"
  ],

  /*-------------
	    Options
	-------------*/
  "group/hiddenrigth": {
    "orientation": "horizontal",
    "modules": [
      "custom/expand-icon#rigth",
      "idle_inhibitor",
      "bluetooth",
      "pulseaudio#input"
    ],
    "drawer": {
      "transition-left-to-right": false
    }
  },
  "custom/expand-icon#rigth": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "group/hiddencenter": {
    "orientation": "horizontal",
    "modules": [
      "custom/expand-icon#left",
      "custom/powerprofile",
      "custom/update"
    ],
    "drawer": {
      "transition-rigth-to-left": false
    }
  },
  "custom/expand-icon#left": {
    "format": "",
    "rotate": 180,
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },

  // "expand-center":
  // "expand-left":
  // "expand-right":
  "layer": "top",
  // "output": ["DP-1"],
  // "position":
  "height": 26,
  "width": 0,
  "margin": 0,
  // "margin-top":
  // "margin-left":
  // "margin-bottom":
  // "margin-right":
  // "no-center":
  "spacing": 0,
  // "name":
  //"mode": "dock",
  // "start_hidden":
  // "modifier-reset":
  // "exclusive":
  // "fixed-center":
  // "passthrough":
  // "ipc":
  // "id":
  "reload_style_on_change": true
  // "on-sigusr1":
  // "on-sigusr2":
  // modulos no usados
  //"custom/user",
}
