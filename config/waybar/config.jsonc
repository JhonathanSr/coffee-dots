{
  /*------------
	    Layout
	------------*/
  "modules-left": [
    "custom/distro",
    "hyprland/workspaces"
  ],
  "modules-center": [
    //"temperature",
    //"memory",
    "cpu",
    "clock#date",
    "clock#time"
  ],
  "modules-right": [
    // "backlight",
    "group/hiddenrigth",
    "network",
    "pulseaudio#output",
    "battery",
    "custom/power"
  ],
  "group/hiddenrigth": {
    "orientation": "horizontal",
    "modules": [
      "custom/expand-icon#rigth",
      "idle_inhibitor",
      "bluetooth",
      "pulseaudio#input",
      "custom/update"
    ],
    "drawer": {
      "transition-left-to-right": false
    }
  },
  /*-------------------
	    Audio
	-------------------*/
  "pulseaudio#output": {
    "format": "{icon} {volume}%",
    "format-muted": "{icon} {volume}%",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "default-muted": "󰝟",
      "headphone": "󰋋",
      "headphone-muted": "󰟎",
      "headset": "󰋎",
      "headset-muted": "󰋐"
    },
    "on-click": "ghostty --title=\"tui\" -e wiremix",
    "on-click-right": "~/.config/coffee/volume output mute",
    "tooltip": false
  },
  /*-------------------
	    tray
	-------------------*/
  "custom/expand-icon#rigth": {
    "format": "",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "custom/expand-icon#left": {
    "format": "",
    "rotate": 180,
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "tray": {
    "icon-size": 16,
    // "show-passive-items":
    // "smooth-scrolling-threshold":
    "spacing": 12,
    // "reverse-direction":
    // "on-update":
    // "expand":
    // "icons":
    "cursor": true
  },
  /*----------------
	    Microphone
	----------------*/
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "~/.config/coffee/volume input mute",
    "tooltip": false
  },
  /*----------------
	    Network
	----------------*/
  "network": {
    "interval": 3,
    "format": "{icon}",
    "format-ethernet": "󰀂",
    "format-wifi": "{icon}",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "on-click": "ghostty --title=\"tui\" -e impala",
    "on-click-right": "~/.config/coffee/network toggle",
    "tooltip-format": "<b>Gateway</b>: {gwaddr}",
    "tooltip-format-ethernet": "<b>Interface</b>: {ifname}",
    "tooltip-format-wifi": "<b>Network</b>: {essid}\n<b>IP Addr</b>: {ipaddr}/{cidr}\n<b>Strength</b>: {signalStrength}%\n<b>Frequency</b>: {frequency} GHz",
    "tooltip-format-disconnected": "Wi-Fi Disconnected",
    "tooltip-format-disabled": "Wi-Fi Disabled"
  },
  /*-------------
	    Ram
	-------------*/
  "memory": {
    "interval": 10,
    "format": "󰘚 {percentage}%",
    "format-warning": "󰀧 {percentage}%",
    "format-critical": "󰀧 {percentage}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "tooltip-format": "Memory Used: {used:0.0f}/{total:0.0f} GiB"
  },
  /*-------------
	    Idle
	-------------*/
  "idle_inhibitor": {
    "format": "{icon} ",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "on-click": "~/.config/coffee/toggle-idle",
    "exec": "~/.config/coffee/idle"
  },
  /*-------------
	    Cpu
	-------------*/
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "format-warning": "󰀨 {usage}%",
    "format-critical": "󰀨 {usage}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "on-click": "uwsm app -- ghostty --title=\"tui\" -e btop",
    "tooltip": false
  },
  /*-------------
	    Reloj
	-------------*/
  "clock#time": {
    "format": "{:%H:%M}",
    "tooltip": false
  },
  /*--------------
	    Calendar
	--------------*/
  "clock#date": {
    "format": "󰸗 {:%d-%m}",
    // "on-click":
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 6,
      "format": {
        "months": "<span alpha='100%'><b>{}</b></span>",
        "days": "<span alpha='90%'>{}</span>",
        "weekdays": "<span alpha='80%'><i>{}</i></span>",
        "today": "<span alpha='100%'><b><u>{}</u></b></span>"
      }
    }
  },
  /*-------------
	    Bluetooth
	-------------*/
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂰",
    "format-connected": "󰂱",
    "on-click": "ghostty --title=\"tui\" -e bluetui",
    "on-click-right": "~/.config/waybar/scripts/bluetooth off",
    "tooltip-format": "Device Addr: {device_address}",
    "tooltip-format-disabled": "Bluetooth Disabled",
    "tooltip-format-off": "Bluetooth Off",
    "tooltip-format-on": "Bluetooth Disconnected",
    "tooltip-format-connected": "Device: {device_alias}",
    "tooltip-format-enumerate-connected": "Device: {device_alias}",
    "tooltip-format-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%",
    "tooltip-format-enumerate-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%"
  },
  /*-------------
	    Battery
	-------------*/
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-time": "{H}h {M}min",
    "format-icons": [
      "󰂎",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-charging": "󰉁 {capacity}%",
    "interval": 5,
    "tooltip-format": "{power:>1.0f}W↓ {capacity}% {time}",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "events": {
      "on-discharging-warning": "notify-send 'Battery Low (20%)' -u critical -i 'battery-020' -h string:x-canonical-private-synchronous:battery",
      "on-discharging-critical": "notify-send 'Battery Critical (10%)' -u critical -i 'battery-010' -h string:x-canonical-private-synchronous:battery",
      "on-charging-100": "notify-send 'Battery Full (100%)' -i 'battery-100-charged' -h string:x-canonical-private-synchronous:battery"
    }
  },
  /*-------------
	    Workspaces
	-------------*/
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5
    },
    "on-click": "activate"
  },
  /*-------------
	    Window
	-------------*/
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "": "Desktop",
      "ghostty": "Terminal",
      "zsh": "Terminal",
      "~": "Terminal"
    },
    "swap-icon-label": false
  },
  /*-------------
	    Update
	-------------*/
  "custom/update": {
    "exec": "~/.config/coffee/update module",
    "hide-empty-text": true,
    "return-type": "json",
    "interval": 21600,
    "signal": 1,
    "format": "{}",
    "on-click": "ghostty --title=\"tui\" -e ~/.config/coffee/update"
  },
  /*-------------
	    Power menu
	-------------*/
  "custom/power": {
    "format": "󰤄",
    "on-click": "~/.config/rofi/scripts/powermenu_t2",
    "tooltip-format": "Power Menu"
  },
  /*-------------
	    Distro
	-------------*/
  "custom/distro": {
    "format": "󰣇",
    "tooltip": false
  },
  /*-------------
	    Options
	-------------*/
  // "expand-center":
  // "expand-left":
  // "expand-right":
  "layer": "top",
  // "output": ["DP-1"],
  "position": "top",
  "height": 26,
  "width": 0,
  "margin": 0,
  // "margin-top":
  // "margin-left":
  // "margin-bottom":
  // "margin-right":
  // "no-center":
  "spacing": 0,
  // "name":
  //"mode": "dock",
  // "start_hidden":
  // "modifier-reset":
  // "exclusive":
  // "fixed-center":
  // "passthrough":
  // "ipc":
  // "id":
  "reload_style_on_change": true
  // "on-sigusr1":
  // "on-sigusr2":
  // modulos no usados
  //"custom/user",
}