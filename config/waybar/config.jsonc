{
  "include": [
    "~/.config/waybar/modules/*.jsonc",
    "~/.config/waybar/modules/custom/*.jsonc",
    "~/.config/waybar/modules/hyprland/*.jsonc"

    // Modules that are not included by default:
    // "~/.config/waybar/modules/extras/*.jsonc"
  ],

  /*------------
	    Layout
	------------*/

  "modules-left": [
    "custom/distro",
    "custom/right_div",
    "custom/right_inv",
    "hyprland/workspaces",
    "custom/right_div"
  ],
  "modules-center": [

    //"temperature",
    //"memory",
    //"cpu",
    "custom/left_div",
    "custom/left_inv",
    "custom/left_div",
    "clock#date",
    "clock#time",
    "custom/right_div",
    "custom/right_inv",
    "custom/right_div"
  ],
  "modules-right": [
    "custom/left_div",
    "custom/media",
    "custom/right_div",
    "custom/right_inv",
    "custom/left_inv",
    "custom/left_div",
    "backlight",
    "battery",
    "idle_inhibitor",
    "network",
    "bluetooth",
    "custom/update",
    "custom/left_inv",
    "custom/left_div",
    "custom/power"
  ],

  /*-------------
	    Options
	-------------*/

  // "expand-center":
  // "expand-left":
  // "expand-right":
  "layer": "top",
  "output": ["DP-1"],
  // "position":
  "height": 22,
  "width": 0,
  "margin": 0,
  // "margin-top":
  // "margin-left":
  // "margin-bottom":
  // "margin-right":
  // "no-center":
  "spacing": 0,
  // "name":
  "mode": "dock",
  // "start_hidden":
  // "modifier-reset":
  // "exclusive":
  // "fixed-center":
  // "passthrough":
  // "ipc":
  // "id":
  "reload_style_on_change": true
  // "on-sigusr1":
  // "on-sigusr2":
  // modulos no usados
  //"custom/user",
}
