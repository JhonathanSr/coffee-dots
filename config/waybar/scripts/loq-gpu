#!/usr/bin/env bash
# -------------------------------------------------------------------------
# Coffee-Dots - LOQ GPU Hot-Unplug/Plug Manager (No Reboot)
# -------------------------------------------------------------------------

PCI_DEV="0000:01:00.0"

off() {
    echo "Cortando hilos fantasmas y removiendo RTX 5050 del bus..."
    
    # 1. Forzar el control del puerto a auto
    if [ -f "/sys/bus/pci/devices/$PCI_DEV/power/control" ]; then
        echo "auto" | sudo tee "/sys/bus/pci/devices/$PCI_DEV/power/control" >/dev/null
    fi

    # 2. Remover la GPU del bus PCIe (Tiro de gracia a los descriptores de Hyprland)
    if [ -e "/sys/bus/pci/devices/$PCI_DEV/remove" ]; then
        echo 1 | sudo tee "/sys/bus/pci/devices/$PCI_DEV/remove" >/dev/null
        notify-send "LOQ GPU" "RTX 5050 removida en caliente. Consumo optimizado (0W)." -i battery
    else
        echo "La GPU ya no se encuentra en el bus u ocurrió un error."
    fi
}

on() {
    echo "Re-escaneando bus PCIe para activar la RTX 5050 (Modo HDMI)..."
    
    # Redirigir el escaneo al bridge del bus PCI para levantar la tarjeta de nuevo
    echo 1 | sudo tee /sys/bus/pci/rescan >/dev/null
    
    sleep 1
    # Asegurar que el bus se configure en auto al despertar
    if [ -f "/sys/bus/pci/devices/$PCI_DEV/power/control" ]; then
        echo "auto" | sudo tee "/sys/bus/pci/devices/$PCI_DEV/power/control" >/dev/null
    fi

    notify-send "LOQ GPU" "RTX 5050 despertada con éxito. Puerto HDMI listo." -i gputop
}

case "${1:-off}" in
    on)  on ;;
    off) off ;;
    *)   echo "Usage: $(basename "$0") {on|off}" ;;
esac
