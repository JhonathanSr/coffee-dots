{
  "custom/update": {
    "exec": "~/.config/coffee/update module",
    "hide-empty-text": true,
    "return-type": "json",
    "interval": 21600,
    "signal": 7,
    "format": "{}",
    "min-length": 2,
    "max-length": 2,
    "on-click": "ghostty --title=\"tui\" -e ~/.config/waybar/scripts/update"
  }
}
