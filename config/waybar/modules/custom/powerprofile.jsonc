{
  "custom/powerprofile": {
    "exec": "echo '{\"text\": \"'$(powerprofilesctl get)'\", \"tooltip\": \"Perfil: '$(powerprofilesctl get)'\", \"alt\": \"'$(powerprofilesctl get)'\"}'",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/profile-switch",
    "format": "{icon}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  }
}
