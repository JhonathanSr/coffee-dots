{
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "format-warning": "󰀨 {usage}%",
    "format-critical": "󰀨 {usage}%",
    "min-length": 7,
    "max-length": 7,
    "states": {
      "warning": 75,
      "critical": 90
    },
    "on-click": "uwsm app -- ghostty --title=\"tui\" -e btop",
    "tooltip": false
  }
}
