/* ==============================================================================
 * ARCHIVO: Waybar Main Configuration (Multi-Monitor Setup)
 * DESCRIPCIÓN: Configuración de la barra de estado para una disposición de doble
 *              monitor. Define la carga de módulos, el posicionamiento y la
 *              persistencia de los workspaces específicos para cada salida.
 * DEPENDENCIAS: modules.jsonc, hyprland.
 * AUTOR: Jhonathan Ruiz (Coffee-Dots)
 * FECHA: 15/05/2026
 * ============================================================================== */
[
  /* --- Monitor Principal (DisplayPort - DP-1) --- */
  /* Este monitor centraliza el monitoreo de hardware (CPU/GPU/RAM) y la 
     gestión de red/multimedia. Utiliza workspaces impares. */
  {
    "include": [
      "~/.config/waybar/modules.jsonc"
    ],
    "output": "DP-1",
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 38,
    "modules-left": [
      "custom/logo",
      "custom/cpu-usage",
      "custom/ram-usage",
      "custom/cpu-temp",
      "custom/gpu-usage"
    ],
    "modules-center": [
      "hyprland/workspaces"
    ],
    "modules-right": [
      "custom/vpn",
      "bluetooth",
      "network",
      "custom/music",
      "custom/wiremix",
      "clock"
    ],
    "hyprland/workspaces": {
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "default": "",
        "1": "1",
        "3": "3",
        "5": "5",
        "7": "7",
        "9": "9",
        "active": "󰊹"
      },
      "persistent-workspaces": {
        "1": [],
        "3": [],
        "5": [],
        "7": [],
        "9": []
      },
      "persistent-only": true
    }
  },
  /* --- Monitor Secundario (HDMI - HDMI-A-1) --- */
  /* Barra minimalista enfocada en la visualización de áreas de trabajo pares
     y la hora, manteniendo el espacio limpio para documentación o monitoreo. */
  {
    "include": [
      "~/.config/waybar/modules.jsonc"
    ],
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 38,
    "modules-left": [
      "custom/logo"
    ],
    "modules-center": [
      "hyprland/workspaces"
    ],
    "modules-right": [
      "clock"
    ],
    "hyprland/workspaces": {
      "on-click": "activate",
      "format": "{icon}",
      "format-icons": {
        "default": "",
        "2": "2",
        "4": "4",
        "6": "6",
        "8": "8",
        "10": "10",
        "active": "󰊹"
      },
      "persistent-workspaces": {
        "2": [],
        "4": [],
        "6": [],
        "8": [],
        "10": []
      },
      "persistent-only": true
    }
  }
]